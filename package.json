{
	"name": "cclens",
	"version": "0.1.0",
	"description": "Claude Code session manager: multi-session TUI + cost dashboard + session summaries",
	"license": "MIT",
	"keywords": [
		"claude",
		"claude-code",
		"worktree",
		"git",
		"tui",
		"cli",
		"cost",
		"dashboard"
	],
	"bin": {
		"cclens": "bin/cli.js"
	},
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "bun run tsc --watch",
		"start": "node dist/cli.js",
		"test": "vitest --run",
		"lint": "bun run eslint src",
		"lint:fix": "bun run eslint src --fix",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build",
		"prepare": "npm run build"
	},
	"files": [
		"dist",
		"bin"
	],
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/bun": "latest",
		"@types/react": "^19.2.9",
		"@typescript-eslint/eslint-plugin": "^8.33.1",
		"@typescript-eslint/parser": "^8.33.1",
		"@vdemedes/prettier-config": "^2.0.1",
		"chalk": "^5.2.0",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.4.1",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^5.2.0",
		"ink-testing-library": "4.0.0",
		"prettier": "^3.0.0",
		"typescript": "^5.0.3",
		"vitest": "^4.0.16"
	},
	"prettier": "@vdemedes/prettier-config",
	"dependencies": {
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/headless": "^6.0.0",
		"effect": "^3.18.2",
		"ink": "^6.6.0",
		"ink-select-input": "^6.0.0",
		"ink-text-input": "^6.0.0",
		"meow": "^14.0.0",
		"react": "^19.2.3",
		"react-devtools-core": "^6.1.2",
		"react-dom": "^19.2.3",
		"strip-ansi": "^7.1.0"
	}
}
